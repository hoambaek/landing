/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# research
/RESEARCH

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright MCP artifacts (스크린샷·console log·snapshot yml)
